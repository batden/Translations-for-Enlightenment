#, c-format
msgid "%s at column %zu"
msgstr "%s à la colonne %zu"

#: src/engine/equation_engine.c:64 src/engine/equation_engine.c:225
msgid "Expression is too deeply nested"
msgstr "L'expression est trop imbriquée"

#: src/engine/equation_engine.c:84
msgid "Bitwise NOT requires programmer mode"
msgstr "L'opérateur NOT bit à bit nécessite le mode programmeur"

#: src/engine/equation_engine.c:89 src/engine/equation_engine.c:156
msgid "Expected closing parenthesis"
msgstr "Parenthèse fermante attendue"

#: src/engine/equation_engine.c:115
msgid "Integer literal exceeds 64 bits"
msgstr "Le littéral entier dépasse 64 bits"

#: src/engine/equation_engine.c:121
msgid "Expected integer digits"
msgstr "Chiffres entiers attendus"

#: src/engine/equation_engine.c:128
msgid "Invalid number"
msgstr "Nombre invalide"

#: src/engine/equation_engine.c:140
msgid "Unknown number or function"
msgstr "Nombre ou fonction inconnu(e)"

#: src/engine/equation_engine.c:151
msgid "Expected function argument in parentheses"
msgstr "Argument de fonction entre parenthèses attendu"

#: src/engine/equation_engine.c:186
msgid "Unknown function"
msgstr "Fonction inconnue"

#: src/engine/equation_engine.c:192 src/engine/equation_engine.c:302
#: src/engine/equation_engine.c:325
msgid "Result is outside the real finite number range"
msgstr "Le résultat se situe en dehors de l'intervalle fini des nombres réels"

#: src/engine/equation_engine.c:249 src/engine/equation_engine.c:289
msgid "Division by zero"
msgstr "Division par zéro"

#: src/engine/equation_engine.c:266
msgid "Shift count must be between 0 and 63"
msgstr "Le décalage de bits doit être compris entre 0 et 63"

#: src/engine/equation_engine.c:299
msgid "Bitwise operators require programmer mode"
msgstr "Les opérateurs NOT bit à bit nécessitent le mode programmeur"

#: src/engine/equation_engine.c:314
msgid "Expression is missing or too long"
msgstr "L'expression est manquante ou trop longue"

#: src/engine/equation_engine.c:323
msgid "Unexpected input"
msgstr "Entrée inattendue"

#: src/engine/equation_engine.c:342 src/engine/equation_engine.c:344
msgid "Requires an integer within 64 bits"
msgstr "Nécessite un entier de 64 bits maximum"

